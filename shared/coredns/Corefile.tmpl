# CoreDNS template rendered by the sandbox bootstrap.
# Substitutions:
#   {{SANDBOX_SLUG}}   → from Instruqt random_id
#   {{ZONE}}           → e.g. iracictechguru.com
#
# Two zones served:
#   1. {{ZONE}}        — forwarder for the lab's hosted zone. Local
#                        /etc/coredns/local.hosts can override specific
#                        names (e.g. force gw.${SLUG}.${ZONE} to the
#                        agentgateway container's address); everything
#                        else flows upstream to public resolvers and
#                        resolves real Route 53 records.
#   2. .  (root)       — recursive forwarder with DNSSEC validation.

{{ZONE}} {
    log
    errors
    # Local hostname override: gateway hostname resolves to internal container.
    hosts /etc/coredns/local.hosts {{ZONE}} {
        fallthrough
    }
    # Anything not in local.hosts: forward to public DNSSEC-validating resolvers.
    forward . 1.1.1.1 9.9.9.9 {
        prefer_udp
    }
    # Cache: 30s TTL with prefetch + short serve_stale.
    # The TTL=30 is dictated by the SVCB record TTL the publish step
    # sets (--ttl 30) so the C2 delete-demo lands in under a minute.
    #
    # prefetch 5 1m 30%: if a record has been queried ≥5 times in the
    # last minute (translator polls every 5s = 12+ queries/min), CoreDNS
    # proactively re-fetches it from upstream when <30% of its TTL
    # remains (~21s in). Result: hot SVCB record never sees a cache
    # miss, so the translator never gets the empty-answer flap that
    # Cloudflare 1.1.1.1 occasionally returns for SVCB queries.
    #
    # serve_stale 30s: safety net — if both prefetch fails AND fresh
    # upstream returns SERVFAIL, keep serving the last-good answer for
    # 30s. Default 'verify' mode means stale is NOT served if upstream
    # returns a valid empty answer (so delete-demo still propagates).
    #
    # Earlier attempt to split into success/denial buckets broke SVCB
    # caching (NOERROR with empty answer section) — keep the simple
    # cache form with these two additions only.
    cache 30 {
        prefetch 5 1m 30%
        serve_stale 30s
    }
}

. {
    log
    errors
    health
    ready
    # Everything OUTSIDE the {{ZONE}} block (Docker service names like
    # agentgateway/event-hub, plus public names such as S3 / Vertex) is
    # forwarded to CoreDNS's OWN Docker embedded DNS (127.0.0.11).
    # 127.0.0.11 resolves lab-network container names locally and
    # forwards genuine public names to the daemon's upstream.
    #
    # Why: the {{ZONE}} block above forwards to 1.1.1.1/9.9.9.9 and
    # RELAYS the DNSSEC AD flag, so lab.ccdesanity.com records validate.
    # This lets us point strands-agent + the host at CoreDNS as their
    # single resolver and get BOTH: the AD flag for the signed zone
    # (needed by trust_dnssec_pointers) AND container-name resolution.
    # (Docker's 127.0.0.11 strips AD — which is exactly why we can't let
    # dns-aid query it directly; it only ever sees the {{ZONE}} block for
    # the DNSSEC-checked names.)
    forward . 127.0.0.11 {
        prefer_udp
    }
    # Cache: 30s TTL with prefetch + short serve_stale.
    # The TTL=30 is dictated by the SVCB record TTL the publish step
    # sets (--ttl 30) so the C2 delete-demo lands in under a minute.
    #
    # prefetch 5 1m 30%: if a record has been queried ≥5 times in the
    # last minute (translator polls every 5s = 12+ queries/min), CoreDNS
    # proactively re-fetches it from upstream when <30% of its TTL
    # remains (~21s in). Result: hot SVCB record never sees a cache
    # miss, so the translator never gets the empty-answer flap that
    # Cloudflare 1.1.1.1 occasionally returns for SVCB queries.
    #
    # serve_stale 30s: safety net — if both prefetch fails AND fresh
    # upstream returns SERVFAIL, keep serving the last-good answer for
    # 30s. Default 'verify' mode means stale is NOT served if upstream
    # returns a valid empty answer (so delete-demo still propagates).
    #
    # Earlier attempt to split into success/denial buckets broke SVCB
    # caching (NOERROR with empty answer section) — keep the simple
    # cache form with these two additions only.
    cache 30 {
        prefetch 5 1m 30%
        serve_stale 30s
    }
}
