{
  "$schema": "https://iracic82.github.io/IETF_Vienna/schemas/dns-aid-cap/v1.json",
  "spec_version": "1.0",
  "agent": "domain-age",
  "version": "1.0.0",
  "protocol": "mcp",
  "transport": "streamable-http",
  "served_by": "https://ietf-vienna-cap-docs.s3.amazonaws.com (S3 public bucket, public-read)",
  "mcp_server_card": "https://ietf-vienna-cap-docs.s3.amazonaws.com/domain-age/mcp-server-card.json",
  "policy": "https://ietf-vienna-cap-docs.s3.amazonaws.com/domain-age/policy.json",
  "policy_uri": "https://ietf-vienna-cap-docs.s3.amazonaws.com/domain-age/policy.json",
  "capabilities": [
    "domain-age"
  ],
  "tools": [
    {
      "name": "lookup_domain",
      "description": "Return registration metadata for a domain.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          }
        },
        "required": [
          "domain"
        ]
      }
    }
  ],
  "trust": {
    "jws_signed": true,
    "signer_hint": "k-ops-team-2026",
    "jwks_uri": "https://ietf-vienna-cap-docs.s3.amazonaws.com/.well-known/jwks.json"
  }
}
