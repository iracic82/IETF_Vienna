{
  "version": "1.0",
  "agent": "url-scanner.lab.ccdesanity.com",
  "issued_at": "2026-05-26T00:00:00Z",
  "issuer": {
    "organization": "IETF_Vienna Demo Federation",
    "kid": "k-ops-team-2026"
  },
  "data_classification": "public",
  "rules": {
    "allowed_methods": [
      "initialize",
      "tools/list",
      "tools/call"
    ],
    "rate_limits": {
      "max_per_minute": 60,
      "max_per_hour": 10000
    },
    "cel_rules": [
      {
        "id": "tool-whitelist",
        "expression": "request.tool_name == null || request.tool_name == 'scan_url'",
        "effect": "deny",
        "message": "Only 'scan_url' is permitted by this policy",
        "enforcement_layers": [
          "layer1",
          "layer2"
        ]
      }
    ]
  },
  "auth": {
    "required": false,
    "schemes": [],
    "note": "Lab demo \u2014 production would require mTLS or OAuth2 bearer."
  },
  "governance": {
    "owner_contact": "soc-federation@workshop.highvelocitynetworking.com",
    "incident_response_runbook": "https://github.com/iracic82/IETF_Vienna/blob/main/docs/caps/url-scanner/INCIDENT-RUNBOOK.md"
  }
}
