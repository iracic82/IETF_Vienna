{
  "$schema": "https://iracic82.github.io/IETF_Vienna/schemas/dns-aid-cap/v1.json",
  "spec_version": "1.0",
  "agent": "url-scanner",
  "version": "1.0.0",
  "protocol": "mcp",
  "transport": "streamable-http",
  "served_by": "https://ietf-vienna-cap-docs.s3.amazonaws.com (S3 public bucket, public-read)",
  "mcp_server_card": "https://ietf-vienna-cap-docs.s3.amazonaws.com/url-scanner/mcp-server-card.json",
  "policy": "https://ietf-vienna-cap-docs.s3.amazonaws.com/url-scanner/policy.json",
  "policy_uri": "https://ietf-vienna-cap-docs.s3.amazonaws.com/url-scanner/policy.json",
  "capabilities": [
    "url-scanner"
  ],
  "tools": [
    {
      "name": "scan_url",
      "description": "Scan a URL for phishing or malware indicators.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Full URL incl. scheme"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  ],
  "trust": {
    "jws_signed": true,
    "signer_hint": "k-ops-team-2026",
    "jwks_uri": "https://ietf-vienna-cap-docs.s3.amazonaws.com/.well-known/jwks.json"
  }
}
