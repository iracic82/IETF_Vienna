{
  "$schema": "https://static.modelcontextprotocol.io/schemas/mcp-server-card/v1.json",
  "version": "1.0",
  "protocolVersion": "2025-06-18",
  "serverInfo": {
    "name": "asn-info",
    "title": "ASN / Geo / ISP Lookup",
    "version": "1.0.0"
  },
  "description": "ASN ownership, country, ISP for an IP address.",
  "documentationUrl": "https://github.com/iracic82/IETF_Vienna/blob/main/docs/caps/asn-info/README.md",
  "transport": {
    "type": "streamable-http",
    "endpoint": "/mcp"
  },
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "authentication": {
    "required": false,
    "schemes": []
  },
  "instructions": "tools/call with name=lookup_asn and arguments matching the inputSchema.",
  "tools": [
    {
      "name": "lookup_asn",
      "description": "Return ASN + country + ISP for an IP.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string"
          }
        },
        "required": [
          "ip"
        ]
      }
    }
  ]
}
