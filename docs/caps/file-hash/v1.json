{
  "$schema": "https://iracic82.github.io/IETF_Vienna/schemas/dns-aid-cap/v1.json",
  "spec_version": "1.0",
  "agent": "file-hash",
  "version": "1.0.0",
  "protocol": "mcp",
  "transport": "streamable-http",
  "served_by": "https://ietf-vienna-cap-docs.s3.amazonaws.com (S3 public bucket, public-read)",
  "mcp_server_card": "https://ietf-vienna-cap-docs.s3.amazonaws.com/file-hash/mcp-server-card.json",
  "policy": "https://ietf-vienna-cap-docs.s3.amazonaws.com/file-hash/policy.json",
  "policy_uri": "https://ietf-vienna-cap-docs.s3.amazonaws.com/file-hash/policy.json",
  "capabilities": [
    "file-hash"
  ],
  "tools": [
    {
      "name": "lookup_hash",
      "description": "Return verdict for a SHA-256 file hash.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "description": "64-char hex SHA-256"
          }
        },
        "required": [
          "sha256"
        ]
      }
    }
  ],
  "trust": {
    "jws_signed": true,
    "signer_hint": "k-ops-team-2026",
    "jwks_uri": "https://ietf-vienna-cap-docs.s3.amazonaws.com/.well-known/jwks.json"
  }
}
