#!/bin/bash
set -uo pipefail
EVENTS=$(curl -fsS "http://localhost:8888/events?since=200" 2>/dev/null || echo "[]")
count=$(echo "${EVENTS}" | python3 -c '
import json, sys
events = json.load(sys.stdin)
print(sum(1 for e in events if e.get("kind") == "tools_call" and e.get("tool") == "lookup_ip"))
' 2>/dev/null || echo 0)
if [ "${count:-0}" -ge 1 ]; then
    echo "✓ ${count} lookup_ip invocation(s) via the federation"
    exit 0
fi
echo "ℹ no lookup_ip call yet — ask the assistant about an IP"
exit 1
